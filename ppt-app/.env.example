# Agent tool access policy: strict | warn | off. Use warn for local hosts that
# have not shipped granted_tools / inherit_host_tools support yet.
# VITE_AGENT_TOOL_ACCESS_POLICY=warn
# Internal test builds only. Shows Performance Testing controls in Settings.
# VITE_PERFORMANCE_TESTING_ENABLED=true
# Internal troubleshooting builds only. Shows Agent resource information in Settings.
# VITE_AGENT_RESOURCE_INFO_ENABLED=true
PPT_APP_DEV_HOST=127.0.0.1
PPT_APP_DEV_PORT=8787
PPT_APP_TASK_ROOT=/absolute/path/to/local/ppt-app-tasks
